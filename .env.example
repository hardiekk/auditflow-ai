# Application
APP_NAME=AuditFlow AI
APP_ENV=development
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=480
API_CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgresql+psycopg://auditflow:auditflow@localhost:5432/auditflow

# Redis / jobs
REDIS_URL=redis://localhost:6379/0
QUEUE_BACKEND=arq

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# AI (optional — mock provider is used when OPENAI_API_KEY is empty)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
LOW_CONFIDENCE_THRESHOLD=0.8

# Auth demo
DEMO_ORG_NAME=Northwind Logistics
DEMO_ADMIN_EMAIL=admin@auditflow.demo
DEMO_ADMIN_PASSWORD=AuditFlow!demo
